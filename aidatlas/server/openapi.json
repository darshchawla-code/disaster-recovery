{
 "openapi": "3.1.0",
 "info": {
  "title": "AidAtlas API",
  "version": "3.0.0",
  "description": "Forecast disaster impact, build need-based relief plans, map risk, score pre-season readiness and receive alerts \u2014 the same models as the AidAtlas web app. Forecasts are estimates, not guarantees.",
  "contact": {
   "name": "@Darshchawla",
   "url": "https://github.com/darshchawla-code/disaster-recovery"
  }
 },
 "servers": [
  {
   "url": "http://localhost:8787",
   "description": "Local (npm run api)"
  }
 ],
 "security": [
  {
   "bearer": []
  },
  {
   "apiKey": []
  }
 ],
 "components": {
  "securitySchemes": {
   "bearer": {
    "type": "http",
    "scheme": "bearer"
   },
   "apiKey": {
    "type": "apiKey",
    "in": "header",
    "name": "X-API-Key"
   }
  },
  "schemas": {
   "Error": {
    "type": "object",
    "properties": {
     "error": {
      "type": "object",
      "properties": {
       "code": {
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "retryAfterSeconds": {
        "type": "integer"
       }
      }
     }
    }
   },
   "Range": {
    "type": "object",
    "properties": {
     "p10": {
      "type": "number"
     },
     "p50": {
      "type": "number"
     },
     "p90": {
      "type": "number"
     }
    },
    "description": "10th, 50th (most likely) and 90th percentile of 400 simulations"
   },
   "Scenario": {
    "type": "object",
    "required": [
     "hazard",
     "magnitude"
    ],
    "properties": {
     "q": {
      "type": "string",
      "description": "Place to search (city, address). Use either q or lat+lon.",
      "example": "Gurugram"
     },
     "lat": {
      "type": "number"
     },
     "lon": {
      "type": "number"
     },
     "hazard": {
      "type": "string",
      "enum": [
       "EQ",
       "TC",
       "FL",
       "VO",
       "DR",
       "WF"
      ],
      "description": "EQ earthquake, TC tropical cyclone, FL flood, VO volcano, DR drought, WF wildfire"
     },
     "magnitude": {
      "type": "number",
      "description": "EQ: moment magnitude 4\u20139.6 \u00b7 TC: max sustained wind km/h 60\u2013350 \u00b7 others: intensity 0.1\u20131",
      "example": 7.2
     },
     "depth": {
      "type": "number",
      "description": "EQ depth km (default 10)"
     },
     "peakInHours": {
      "type": "number",
      "description": "TC/FL: hours until the peak (default 0)"
     },
     "radiusKm": {
      "type": "number",
      "description": "FL: flood radius (default 40)"
     },
     "areaKm2": {
      "type": "number",
      "description": "WF/DR area"
     },
     "name": {
      "type": "string"
     }
    }
   },
   "Inventory": {
    "type": "array",
    "description": "Your stores, same columns as the app's CSV import: name, lat, lon, type, water_l, food_kg, tents, medkits, staff, trucks, buses, ambulances, beds, address",
    "items": {
     "type": "object"
    }
   }
  },
  "responses": {
   "Error": {
    "description": "Error",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   }
  }
 },
 "paths": {
  "/v1/health": {
   "get": {
    "summary": "Service status",
    "security": [],
    "responses": {
     "200": {
      "description": "OK"
     }
    }
   }
  },
  "/v1/openapi.json": {
   "get": {
    "summary": "This document",
    "security": [],
    "responses": {
     "200": {
      "description": "OpenAPI 3.1"
     }
    }
   }
  },
  "/v1/usage": {
   "get": {
    "summary": "Calls used this month and your limits",
    "responses": {
     "200": {
      "description": "Usage"
     },
     "401": {
      "$ref": "#/components/responses/Error"
     }
    }
   }
  },
  "/v1/events": {
   "get": {
    "summary": "Disasters happening now, ranked by the Unified Severity Index (GDACS, USGS, NASA EONET)",
    "parameters": [
     {
      "name": "limit",
      "in": "query",
      "schema": {
       "type": "integer",
       "default": 20,
       "maximum": 200
      }
     },
     {
      "name": "hazard",
      "in": "query",
      "schema": {
       "type": "string",
       "enum": [
        "EQ",
        "TC",
        "FL",
        "VO",
        "DR",
        "WF"
       ]
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Ranked events"
     },
     "429": {
      "$ref": "#/components/responses/Error"
     }
    }
   }
  },
  "/v1/forecast": {
   "post": {
    "summary": "Quick impact forecast for a scenario: people affected, displaced, injured and killed (P10/P50/P90) per area, plus 72-hour P90 needs",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Scenario"
       },
       "example": {
        "q": "Gurugram",
        "hazard": "EQ",
        "magnitude": 7.2
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Forecast"
     },
     "400": {
      "$ref": "#/components/responses/Error"
     },
     "404": {
      "$ref": "#/components/responses/Error"
     }
    }
   }
  },
  "/v1/plan": {
   "post": {
    "summary": "Full relief plan: forecast, need scores, allocation (MILP), dispatches, casualty transport, gaps, storage sites, key actions and savings vs the nearest-store rule. Takes 20\u201390 s; plans run one at a time.",
    "parameters": [
     {
      "name": "geometry",
      "in": "query",
      "schema": {
       "type": "string",
       "enum": [
        "1"
       ]
      },
      "description": "Include road route coordinates"
     },
     {
      "name": "format",
      "in": "query",
      "schema": {
       "type": "string",
       "enum": [
        "geojson"
       ]
      },
      "description": "geojson = the plan as one GeoJSON FeatureCollection (ArcGIS, QGIS)"
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "allOf": [
         {
          "$ref": "#/components/schemas/Scenario"
         },
         {
          "type": "object",
          "properties": {
           "supplyScale": {
            "type": "number",
            "default": 1
           },
           "storageSites": {
            "type": "boolean",
            "default": true
           },
           "worldpop": {
            "type": "boolean",
            "default": true,
            "description": "false = faster, uses OpenStreetMap populations"
           },
           "inventory": {
            "$ref": "#/components/schemas/Inventory"
           },
           "inventoryUrl": {
            "type": "string",
            "description": "Google Sheet / CSV / JSON link with your stores"
           },
           "geometry": {
            "type": "boolean"
           }
          }
         }
        ]
       },
       "example": {
        "q": "Kathmandu",
        "hazard": "EQ",
        "magnitude": 7.8,
        "worldpop": false
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Plan"
     },
     "400": {
      "$ref": "#/components/responses/Error"
     },
     "503": {
      "$ref": "#/components/responses/Error"
     },
     "504": {
      "$ref": "#/components/responses/Error"
     }
    }
   }
  },
  "/v1/risk": {
   "get": {
    "summary": "6 \u00d7 6 risk grid (~120 \u00d7 120 km) and the five highest-risk areas (INFORM method). Cached 24 h.",
    "parameters": [
     {
      "name": "q",
      "in": "query",
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "lat",
      "in": "query",
      "schema": {
       "type": "number"
      }
     },
     {
      "name": "lon",
      "in": "query",
      "schema": {
       "type": "number"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Risk grid"
     }
    }
   }
  },
  "/v1/readiness": {
   "post": {
    "summary": "Pre-season readiness score (0\u2013100) of a district: stock and vehicles within 3 h by road vs the P90 first 72 h in each of its five highest-risk areas",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "q": {
          "type": "string"
         },
         "lat": {
          "type": "number"
         },
         "lon": {
          "type": "number"
         },
         "inventory": {
          "$ref": "#/components/schemas/Inventory"
         },
         "inventoryUrl": {
          "type": "string"
         }
        }
       },
       "example": {
        "q": "Guwahati",
        "inventoryUrl": "https://docs.google.com/spreadsheets/d/\u2026/edit"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Readiness"
     }
    }
   }
  },
  "/v1/webhooks": {
   "get": {
    "summary": "Your webhooks",
    "responses": {
     "200": {
      "description": "List"
     }
    }
   },
   "post": {
    "summary": "Create an alert webhook for a watch area. AidAtlas checks live events every 10 minutes and POSTs each new (event, level) once. Verify X-AidAtlas-Signature: v1=hex(HMAC-SHA256(secret, X-AidAtlas-Timestamp + '.' + rawBody)).",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "url",
         "area"
        ],
        "properties": {
         "url": {
          "type": "string",
          "description": "https:// endpoint"
         },
         "events": {
          "type": "array",
          "items": {
           "type": "string",
           "enum": [
            "alert"
           ]
          }
         },
         "area": {
          "type": "object",
          "required": [
           "lat",
           "lon"
          ],
          "properties": {
           "name": {
            "type": "string"
           },
           "lat": {
            "type": "number"
           },
           "lon": {
            "type": "number"
           },
           "radiusKm": {
            "type": "number",
            "default": 100
           },
           "hazards": {
            "type": "array",
            "items": {
             "type": "string",
             "enum": [
              "EQ",
              "TC",
              "FL",
              "VO",
              "DR",
              "WF"
             ]
            }
           },
           "minLevel": {
            "type": "string",
            "enum": [
             "Green",
             "Orange",
             "Red"
            ],
            "default": "Orange"
           }
          }
         }
        }
       },
       "example": {
        "url": "https://example.org/aidatlas-hook",
        "area": {
         "name": "Gurugram district",
         "lat": 28.46,
         "lon": 77.03,
         "radiusKm": 150,
         "minLevel": "Orange"
        }
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "Created; the response holds the signing secret once"
     }
    }
   }
  },
  "/v1/webhooks/{id}": {
   "delete": {
    "summary": "Delete a webhook",
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Deleted"
     }
    }
   }
  },
  "/v1/webhooks/{id}/test": {
   "post": {
    "summary": "Send a signed test delivery",
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Delivery result"
     }
    }
   }
  },
  "/v1/model-cards": {
   "get": {
    "summary": "Model cards: what each model does, its evidence and its limits",
    "security": [],
    "responses": {
     "200": {
      "description": "Cards"
     }
    }
   }
  },
  "/v1/backtest": {
   "get": {
    "summary": "Back-test of the earthquake model against every earthquake since 2001 with 250+ deaths (NOAA NCEI). Cached 7 days; the first call takes several minutes.",
    "parameters": [
     {
      "name": "worldpop",
      "in": "query",
      "schema": {
       "type": "string",
       "enum": [
        "1"
       ]
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Results and summary"
     }
    }
   }
  }
 }
}